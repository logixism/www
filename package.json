{
  "name": "logix-pure-html-ssr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun run scripts/build.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests scripts playwright.config.ts",
    "check": "bun run typecheck && bun run lint && bun run build"
  },
  "dependencies": {
    "@m3e/icons": "1.0.12",
    "@m3e/web": "2.7.4",
    "lit": "3.3.3",
    "sharp": "^0.35.3",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/bun": "1.3.14",
    "happy-dom": "20.11.2",
    "oxlint": "1.76.0",
    "typescript": "6.0.2"
  }
}
